{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ reads the text you select through Accessibility. Turn on %@ in System Settings → Privacy & Security → Accessibility; this window moves on by itself." : {
      "comment" : "Onboarding accessibility explanation; both arguments are the app name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 通过辅助功能读取你选中的文字。请在“系统设置 → 隐私与安全性 → 辅助功能”中打开 %2$@，打开后这个窗口会自动进入下一步。"
          }
        }
      }
    },
    "%@ shortcut: %@" : {
      "comment" : "Menu item for a shortcut problem; the arguments are the shortcut name and the problem",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”快捷键：%2$@"
          }
        }
      }
    },
    "%@ translates with a model you choose, using your own API key. Paste the key and press Test. You can also do this later in Settings." : {
      "comment" : "Onboarding model explanation; the argument is the app name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 用你自己的 API 密钥请求你选择的模型来翻译。粘贴密钥后点「测试」。也可以以后在设置里填写。"
          }
        }
      }
    },
    "About %@" : {
      "comment" : "Menu item that opens the About panel",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于 %@"
          }
        }
      }
    },
    "Accessibility is on." : {
      "comment" : "Onboarding: the permission is granted",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助功能权限已打开。"
          }
        }
      }
    },
    "Add your API key" : {
      "comment" : "Title of the onboarding step that sets up a model",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写 API 密钥"
          }
        }
      }
    },
    "Allow %@ to read selected text" : {
      "comment" : "Title of the onboarding accessibility step; the argument is the app name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 %@ 读取选中的文字"
          }
        }
      }
    },
    "Back" : {
      "comment" : "Onboarding button",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一步"
          }
        }
      }
    },
    "Check for Updates…" : {
      "comment" : "Menu item that checks for a new version",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检查更新…"
          }
        }
      }
    },
    "Continue" : {
      "comment" : "Onboarding button",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "继续"
          }
        }
      }
    },
    "Couldn’t read the selection" : {
      "comment" : "Panel title when the selected text could not be read",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取选中的文字"
          }
        }
      }
    },
    "Done" : {
      "comment" : "Onboarding button that finishes it",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成"
          }
        }
      }
    },
    "Not Now" : {
      "comment" : "Onboarding button that skips the model step",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以后再说"
          }
        }
      }
    },
    "Open System Settings" : {
      "comment" : "Onboarding button that opens the Accessibility settings",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开系统设置"
          }
        }
      }
    },
    "Quit %@" : {
      "comment" : "Menu item that quits the app",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "退出 %@"
          }
        }
      }
    },
    "See a translation in the panel before you start." : {
      "comment" : "Onboarding sample explanation when no Read shortcut is set",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始使用前，先在面板里看一次翻译效果。"
          }
        }
      }
    },
    "Select text in any app and press %@. Or translate this sample now:" : {
      "comment" : "Onboarding sample explanation; the argument is the Read shortcut, such as ⌃⌥D",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意应用里选中文字，然后按 %@。也可以现在翻译下面这段示例："
          }
        }
      }
    },
    "Step %lld of %lld" : {
      "comment" : "Onboarding progress; the arguments are the step number and the step count",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "第 %1$lld 步，共 %2$lld 步"
          }
        }
      }
    },
    "Translate Sample" : {
      "comment" : "Onboarding button that translates the sample in the result panel",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻译示例"
          }
        }
      }
    },
    "Try it" : {
      "comment" : "Title of the onboarding step with a sample",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试一下"
          }
        }
      }
    },
    "Welcome to %@" : {
      "comment" : "Title of the first-run window; the argument is the app name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎使用 %@"
          }
