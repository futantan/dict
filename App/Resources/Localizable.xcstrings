    },
    "Without a model, Dict translates on this Mac with Apple Translation. It needs %@ and %@ downloaded once." : {
      "comment" : "Onboarding translation explanation; the arguments are two language names",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
