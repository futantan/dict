{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and %@ are ready." : {
      "comment" : "Onboarding: both languages are downloaded; the arguments are language names",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@和%2$@已就绪。"
          }
        }
      }
    },
    "%@ reads the text you select through Accessibility. Turn on %@ in System Settings → Privacy & Security → Accessibility; this window moves on by itself." : {
      "comment" : "Onboarding accessibility explanation; both arguments are the app name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 通过辅助功能读取你选中的文字。请在“系统设置 → 隐私与安全性 → 辅助功能”中打开 %2$@，打开后这个窗口会自动进入下一步。"
          }
        }
      }
    },
    "%@ shortcut: %@" : {
      "comment" : "Menu item for a shortcut problem; the arguments are the shortcut name and the problem",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”快捷键：%2$@"
          }
        }
      }
    },
    "About %@" : {
      "comment" : "Menu item that opens the About panel",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于 %@"
          }
        }
      }
    },
    "Accessibility is on." : {
      "comment" : "Onboarding: the permission is granted",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助功能权限已打开。"
          }
        }
      }
    },
    "Allow %@ to read selected text" : {
      "comment" : "Title of the onboarding accessibility step; the argument is the app name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 %@ 读取选中的文字"
          }
        }
      }
    },
    "Apple Translation doesn’t support %@ and %@. Set up a model in Settings instead." : {
      "comment" : "Onboarding: the pair is not supported; the arguments are language names",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 翻译不支持%1$@和%2$@。请改在设置中配置模型。"
          }
        }
      }
    },
    "Back" : {
      "comment" : "Onboarding button",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一步"
          }
        }
      }
    },
    "Checking…" : {
      "comment" : "Onboarding: checking the languages",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在检查…"
          }
