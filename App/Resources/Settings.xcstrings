          "stringUnit" : {
            "state" : "translated",
            "value" : "模型的 JSON 回答被截断了。"
          }
        }
      }
    },
    "The service didn’t answer in time." : {
      "comment" : "Connection test: the request timed out",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务没有及时回应。"
          }
        }
      }
    },
    "The service has a problem (HTTP %@). Try again later." : {
      "comment" : "Connection test: HTTP 5xx. The argument is the status",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务出现问题（HTTP %@）。请稍后再试。"
          }
        }
      }
    },
    "The service has no model with this name." : {
      "comment" : "Connection test: HTTP 404",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务上没有这个名称的模型。"
          }
        }
      }
    },
    "The service is limiting requests, or the account is out of credit. Try again later." : {
      "comment" : "Connection test: HTTP 429",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务正在限制请求，或者账户余额不足。请稍后再试。"
          }
        }
      }
    },
    "The service listed no models." : {
      "comment" : "Listing models found none",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务没有列出任何模型。"
          }
        }
      }
    },
    "The service rejected the API key. Check that it is correct and active." : {
      "comment" : "Connection test: HTTP 401 or 403",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务拒绝了这个 API 密钥。请确认它正确并且仍然有效。"
          }
        }
      }
    },
    "The service rejected the request: %@" : {
