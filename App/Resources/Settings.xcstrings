    },
    "Text you look up or translate is sent to %@." : {
      "comment" : "Privacy note for a provider without a key. The argument is the provider name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查询或翻译的文字会发送给 %@。"
          }
        }
      }
    },
    "Text you look up or translate is sent to %@. Your API key is kept in the Keychain." : {
      "comment" : "Privacy note under the model settings. The argument is the provider name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查询或翻译的文字会发送给 %@。API 密钥保存在钥匙串中。"
          }
        }
      }
    },
    "Text you look up or translate is sent to the service at this base URL. Your API key is kept in the Keychain." : {
      "comment" : "Privacy note under the settings of a custom provider",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查询或翻译的文字会发送给这个 Base URL 上的服务。API 密钥保存在钥匙串中。"
          }
        }
      }
    },
    "The answer stopped before it was complete." : {
      "comment" : "Connection test: the strict JSON answer ended without a finish reason",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答没有完成就中断了。"
          }
        }
      }
    },
    "The first words came after %@ s." : {
      "comment" : "Translation check passed. The argument is a number of seconds",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 秒后收到第一个字。"
          }
        }
      }
    },
    "The model answers in the requested JSON format." : {
      "comment" : "Structured output check passed",
