    },
    "Text in your language is translated into the language you’re learning, and everything else into your language." : {
      "comment" : "Footer under the language pickers",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的语言会译成你在学的语言，其他语言都会译成你的语言。"
          }
        }
      }
    },
    "Text you look up or translate is sent to %@." : {
      "comment" : "Privacy note for a provider without a key. The argument is the provider name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查询或翻译的文字会发送给 %@。"
          }
        }
      }
    },
    "Text you look up or translate is sent to %@. Your API key is kept in the Keychain." : {
      "comment" : "Privacy note under the model settings. The argument is the provider name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查询或翻译的文字会发送给 %@。API 密钥保存在钥匙串中。"
          }
        }
      }
    },
    "Text you look up or translate is sent to the service at this base URL. Your API key is kept in the Keychain." : {
      "comment" : "Privacy note under the settings of a custom provider",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你查询或翻译的文字会发送给这个 Base URL 上的服务。API 密钥保存在钥匙串中。"
          }
        }
      }
    },
    "The service didn’t answer in time." : {
      "comment" : "Connection test: the request timed out",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务没有及时回应。"
          }
        }
      }
    },
    "The service has a problem (HTTP %@). Try again later." : {
      "comment" : "Connection test: HTTP 5xx. The argument is the status",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务出现问题（HTTP %@）。请稍后再试。"
          }
        }
      }
    },
    "The service has no model with this name." : {
      "comment" : "Connection test: HTTP 404",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务上没有这个名称的模型。"
          }
        }
      }
    },
    "The service is limiting requests, or the account is out of credit. Try again later." : {
      "comment" : "Connection test: HTTP 429",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务正在限制请求，或者账户余额不足。请稍后再试。"
          }
        }
      }
    },
    "The service rejected the API key. Check that it is correct and active." : {
      "comment" : "Connection test: HTTP 401 or 403",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务拒绝了这个 API 密钥。请确认它正确并且仍然有效。"
          }
        }
      }
    },
    "The service rejected the request: %@" : {
      "comment" : "Connection test: HTTP 400. The argument is the service's own message",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务拒绝了请求：%@"
          }
        }
      }
    },
    "The service returned an empty answer." : {
      "comment" : "Connection test: no content came back",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务返回了空的回应。"
          }
        }
      }
    },
    "The service’s answer couldn’t be read. Check that the base URL is an OpenAI-compatible API." : {
      "comment" : "Connection test: the response was not Chat Completions",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取服务的回应。请确认 Base URL 指向兼容 OpenAI 的 API。"
          }
        }
      }
    },
    "This Mac is offline." : {
      "comment" : "Connection test: no network connection",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 没有联网。"
          }
        }
      }
    },
    "This provider is no longer available. Choose another one." : {
      "comment" : "The saved provider is not in the preset table",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个服务商已不再可用，请选择其他服务商。"
          }
        }
      }
    },
    "Traditional Chinese" : {
      "comment" : "Language name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繁体中文"
          }
        }
      }
    },
    "Use https://. Plain http:// is only allowed for services on this Mac." : {
      "comment" : "The base URL uses http to another computer",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用 https://。只有这台 Mac 上的服务才允许使用 http://。"
          }
        }
      }
    },
    "Used when Dict reads English words and sentences aloud." : {
      "comment" : "Footer under the accent picker",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dict 朗读英文单词和句子时使用。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
