{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "comment" : "About: the app name and version",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ voice · %@" : {
      "comment" : "Settings row: the voice used; the arguments are the language and voice name",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@语音 · %2$@"
          }
        }
      }
    },
    "%lld words and %lld sentences, never uploaded to any server." : {
      "comment" : "Data and privacy: what is kept on this Mac",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共 %1$lld 个词、%2$lld 句，不会上传到任何服务器。"
