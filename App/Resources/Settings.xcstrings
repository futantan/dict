    "Choose a provider." : {
      "comment" : "The model settings have no provider",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择服务商。"
          }
        }
      }
    },
    "Click a shortcut and press the new keys. Press Delete to remove it, or Esc to cancel." : {
      "comment" : "Footer under the shortcut fields",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按快捷键，然后按下新的组合键。按 Delete 删除，按 Esc 取消。"
          }
        }
      }
    },
    "Connected. The model answered in %@ s." : {
      "comment" : "Test succeeded. The argument is a number of seconds",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已连接，模型在 %@ 秒内作出了回应。"
          }
        }
      }
    },
    "Couldn’t access the Keychain (error %@)." : {
      "comment" : "Reading or saving the API key failed. The argument is an error number",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问钥匙串（错误 %@）。"
          }
        }
      }
    },
    "Couldn’t connect to the service (error %@). Check the base URL." : {
      "comment" : "Connection test: a network error. The argument is its code",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到服务（错误 %@）。请检查 Base URL。"
          }
        }
      }
    },
    "Custom (OpenAI-compatible)" : {
      "comment" : "Model provider choice for any service with an OpenAI-compatible API",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义（兼容 OpenAI）"
          }
        }
      }
    },
    "Dict translates with a model you choose, using your own API key or Ollama on this Mac. Correcting and polishing your writing need it too." : {
      "comment" : "Footer when no model provider is chosen",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dict 用你选择的模型翻译，使用你自己的 API 密钥，或这台 Mac 上的 Ollama。纠错和润色同样需要模型。"
          }
        }
      }
    },
    "Enter a URL that starts with https://, such as https://api.example.com/v1." : {
      "comment" : "The base URL is not a valid web address",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入以 https:// 开头的地址，例如 https://api.example.com/v1。"
          }
        }
      }
    },
    "Enter a model name." : {
      "comment" : "The model name field is empty",
      "localizations" : {
