    },
    "Dict can use this model, but it is slow." : {
      "comment" : "Test finished; every check passed but the model thinks",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dict 可以使用这个模型，但它很慢。"
