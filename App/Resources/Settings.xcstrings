    "Change these only if the test fails. Automatic asks for a strict JSON schema and leaves it out when the service rejects it." : {
      "comment" : "Footer under the custom provider's advanced options",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在测试失败时修改。「自动」会要求严格的 JSON 结构，服务不接受时自动去掉。"
          }
        }
      }
    },
    "Choose a listed model" : {
      "comment" : "Help tag of the menu of listed models",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择列出的模型"
          }
        }
      }
    },
    "Choose a provider." : {
      "comment" : "The model settings have no provider",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择服务商。"
          }
        }
      }
    },
    "Choose one of the models listed above." : {
      "comment" : "Hint after the service did not know the model name; its list is shown",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从上面列出的模型中选一个。"
          }
        }
      }
    },
    "Click a shortcut and press the new keys, or press a modifier key twice. Press Delete to remove it, or Esc to cancel." : {
      "comment" : "Footer under the shortcut fields",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按快捷键，然后按下新的组合键，或者连按两次一个修饰键。按 Delete 删除，按 Esc 取消。"
          }
        }
      }
    },
    "Couldn’t access the Keychain (error %@)." : {
      "comment" : "Reading or saving the API key failed. The argument is an error number",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法访问钥匙串（错误 %@）。"
          }
        }
      }
    },
    "Couldn’t connect to the service (error %@). Check the base URL." : {
      "comment" : "Connection test: a network error. The argument is its code",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到服务（错误 %@）。请检查 Base URL。"
          }
        }
      }
    },
    "Couldn’t reach Ollama. Check that it is running on this Mac." : {
      "comment" : "Listing Ollama models failed to connect",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连不上 Ollama。请确认它正在这台 Mac 上运行。"
          }
        }
      }
    },
    "Custom (OpenAI-compatible)" : {
      "comment" : "Model provider choice for any service with an OpenAI-compatible API",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义（兼容 OpenAI）"
