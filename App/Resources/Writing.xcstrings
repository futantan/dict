            "value" : "被内容过滤拦下了"
          }
        }
      }
    },
    "Can’t replace text in this app; copy it instead." : {
      "comment" : "Panel footer when the selection's field cannot be written",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在这个应用里替换，请复制使用。"
          }
        }
      }
    },
    "Checking spelling and grammar…" : {
      "comment" : "Panel footer while the selected text is being proofread",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在检查拼写和语法…"
          }
        }
      }
    },
    "Click a change, or use ← → and Space, to accept or decline it" : {
      "comment" : "Tooltip of the proofread text",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
