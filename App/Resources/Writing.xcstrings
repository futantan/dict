      "comment" : "Panel footer: how many of the corrections are accepted, when not all are",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已接受 %1$lld/%2$lld 处修改"
