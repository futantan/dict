// Single source of truth for the product name, bundle identifier and signing team.
// Rename the app by changing DICT_PRODUCT_NAME and DICT_BUNDLE_ID here only.

DICT_PRODUCT_NAME = Dict
DICT_BUNDLE_ID = au.ibra.dict

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

DEVELOPMENT_TEAM = M5ZVXWJNK8
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
ENABLE_HARDENED_RUNTIME = YES

// Auto-update (Design/architecture.md 15.6). Before the first release, replace OWNER with the
// GitHub account and paste the public key printed by Sparkle's generate_keys; until then the
// updater does not start. `//` starts a comment in an xcconfig, hence `/$()/`; write any `//`
// in the key the same way.
DICT_UPDATE_FEED_URL = https:/$()/github.com/futantan/dict/releases/latest/download/appcast.xml
DICT_UPDATE_PUBLIC_KEY = eodyMRTGJ+udKqjQtgBdcNXmBxVR3S/oFqICch86RrM=

MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
