{
  "scenarios": [
    {
      "name": "plain text view",
      "control": "textView.plain",
      "text": "quick brown fox",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "quick brown fox", "copyEvents": 0 }
    },
    {
      "name": "rich text view",
      "control": "textView.rich",
      "text": "black quartz",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "black quartz", "copyEvents": 0 }
    },
    {
      "name": "text field",
      "control": "textField",
      "text": "five dozen liquor jugs",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "five dozen liquor jugs", "copyEvents": 0 }
    },
    {
      "name": "web read-only paragraph",
      "control": "web.paragraph",
      "text": "jumps over the lazy dog",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "jumps over the lazy dog", "copyEvents": 0 }
    },
    {
      "name": "web read-only text across an inline tag",
      "control": "web.paragraph",
      "text": "a bright cold day",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "a bright cold day", "copyEvents": 0 }
    },
    {
      "name": "web textarea",
      "control": "web.textarea",
      "text": "five dozen liquor jugs",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "five dozen liquor jugs", "copyEvents": 0 }
    },
    {
      "name": "web contenteditable",
      "control": "web.contenteditable",
      "text": "daft zebras jump",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "daft zebras jump", "copyEvents": 0 }
    },
    {
      "name": "plain text view, clipboard never",
      "control": "textView.plain",
      "text": "lazy dog",
      "policy": "never",
      "expect": { "source": "accessibility", "text": "lazy dog", "copyEvents": 0 }
    },
    {
      "name": "custom view via menu Copy",
      "control": "custom.noSelectedText",
      "text": "big sphinx",
      "policy": "allowed",
      "expect": { "source": "menuCopy", "text": "big sphinx", "copyEvents": 1 }
    },
    {
      "name": "custom view, clipboard never",
      "control": "custom.noSelectedText",
      "text": "big sphinx",
      "policy": "never",
      "expect": { "failure": "unreadable", "copyEvents": 0 }
    },
    {
      "name": "custom view without selection",
      "control": "custom.empty",
      "text": "",
      "policy": "allowed",
      "expect": { "failure": "nothingSelected", "copyEvents": 0 }
    },
    {
      "name": "custom view that copies the whole line",
      "control": "custom.copiesLine",
      "text": "let second",
      "policy": "allowed",
      "expect": { "failure": "nothingSelected", "copyEvents": 1 }
    },
    {
      "name": "password field",
      "control": "secureField",
      "text": "horse",
      "policy": "allowed",
      "expect": { "failure": "secureField", "copyEvents": 0 }
    },
    {
      "name": "shortcut, plain text view: no reading panel",
      "control": "textView.plain",
      "text": "quick brown fox",
      "policy": "allowed",
      "step": "read",
      "expect": { "source": "accessibility", "text": "quick brown fox", "copyEvents": 0, "readingPanel": false }
    },
    {
      "name": "shortcut, custom view: reading panel, then menu Copy",
      "control": "custom.noSelectedText",
      "text": "big sphinx",
      "policy": "allowed",
      "step": "read",
      "expect": { "source": "menuCopy", "text": "big sphinx", "copyEvents": 1, "readingPanel": true }
    },
    {
      "name": "shortcut, custom view: reading panel, then ⌘C",
      "control": "custom.noSelectedText",
      "text": "big sphinx",
      "policy": "allowed",
      "step": "read",
      "force": "key",
      "expect": { "source": "keyCopy", "text": "big sphinx", "copyEvents": 1, "readingPanel": true }
    },
    {
      "name": "shortcut, custom view without selection: reading panel, then input",
      "control": "custom.empty",
      "text": "",
      "policy": "allowed",
      "step": "read",
      "expect": { "failure": "nothingSelected", "copyEvents": 0, "readingPanel": true }
    },
    {
      "name": "shortcut, custom view copying the whole line: reading panel, then input",
      "control": "custom.copiesLine",
      "text": "let second",
      "policy": "allowed",
      "step": "read",
      "expect": { "failure": "nothingSelected", "copyEvents": 1, "readingPanel": true }
    },
    {
      "name": "shortcut, text view: menu Copy with the panel key",
      "control": "textView.plain",
      "text": "lazy dog",
      "policy": "allowed",
      "step": "read",
      "force": "menu",
      "expect": { "source": "menuCopy", "text": "lazy dog", "copyEvents": 1, "readingPanel": true }
    },
    {
      "name": "shortcut, text view: ⌘C with the panel key",
      "control": "textView.plain",
      "text": "lazy dog",
      "policy": "allowed",
      "step": "read",
      "force": "key",
      "expect": { "source": "keyCopy", "text": "lazy dog", "copyEvents": 1, "readingPanel": true }
    },
    {
      "name": "shortcut, web paragraph: menu Copy with the panel key",
      "control": "web.paragraph",
      "text": "jumps over the lazy dog",
      "policy": "allowed",
      "step": "read",
      "force": "menu",
      "expect": { "source": "menuCopy", "text": "jumps over the lazy dog", "copyEvents": 1, "readingPanel": true }
    },
    {
      "name": "shortcut, web paragraph: ⌘C with the panel key",
      "control": "web.paragraph",
      "text": "jumps over the lazy dog",
      "policy": "allowed",
      "step": "read",
      "force": "key",
      "expect": { "source": "keyCopy", "text": "jumps over the lazy dog", "copyEvents": 1, "readingPanel": true }
    },
    {
      "name": "context, web paragraph: word inside an inline tag",
      "control": "web.paragraph",
      "text": "bright",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "bright", "copyEvents": 0, "context": "It was a bright cold day in April." }
    },
    {
      "name": "context, web paragraph: link in the second paragraph",
      "control": "web.paragraph",
      "text": "link",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "link", "copyEvents": 0, "context": "Second paragraph with a link inside it." }
    },
    {
      "name": "context, web contenteditable: second paragraph",
      "control": "web.contenteditable",
      "text": "editable",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "editable", "copyEvents": 0, "context": "Another editable paragraph." }
    },
    {
      "name": "context, web textarea: second line",
      "control": "web.textarea",
      "text": "line of",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "line of", "copyEvents": 0, "context": "Second line of the textarea." }
    },
    {
      "name": "context, text view: abbreviation in the second paragraph",
      "control": "textView.plain",
      "text": "Smith",
      "content": "The first paragraph ends here.\n\nDr. Smith opened the second one, e.g. with a joke. It has two sentences.",
      "policy": "allowed",
      "expect": { "source": "accessibility", "text": "Smith", "copyEvents": 0, "context": "Dr. Smith opened the second one, e.g. with a joke." }
    }
  ]
}
