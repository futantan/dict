{
  "sourceLanguage" : "en",
  "strings" : {
    "Add ⌃, ⌥ or ⌘ so the key does not type text." : {
      "comment" : "A shortcut was recorded without a modifier key",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请加上 ⌃、⌥ 或 ⌘，否则这个键会输入文字。"
          }
        }
      }
    },
    "Choose your shortcuts" : {
      "comment" : "Title of the onboarding step that picks the two shortcuts",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择快捷键"
          }
        }
      }
    },
    "Correct, polish or translate what you are writing." : {
      "comment" : "What the Write shortcut does",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纠错、润色或翻译你正在写的文字。"
          }
        }
      }
    },
    "Look up or translate the selected text." : {
      "comment" : "What the Read shortcut does",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查词或翻译选中的文字。"
          }
        }
      }
    },
    "Only Read is needed to start. You can change both later in Settings." : {
      "comment" : "Footnote in the onboarding step that picks the two shortcuts",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始使用只需要「读」快捷键。两个快捷键以后都可以在设置里更改。"
          }
        }
      }
    },
    "Optional" : {
      "comment" : "Next to the Write shortcut in onboarding: it can be left empty",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选"
          }
        }
      }
    },
    "Press keys…" : {
      "comment" : "Shown in the shortcut field while waiting for a key press",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请按下组合键…"
          }
        }
      }
    },
    "Read" : {
      "comment" : "Name of the shortcut that looks up or translates the selection",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读"
          }
        }
      }
    },
    "Record Shortcut" : {
      "comment" : "Shortcut field with no shortcut; clicking it starts recording",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制快捷键"
          }
        }
      }
    },
    "Remove shortcut" : {
      "comment" : "Help tag of the button that removes a shortcut",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除快捷键"
          }
        }
      }
    },
    "Right %@" : {
      "comment" : "A shortcut that is the right-hand modifier key pressed twice, for example ⌘ ⌘",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右 %@"
          }
        }
      }
    },
    "Select text in any app and press a shortcut. Pick one you do not use elsewhere, such as ⌃⌥ with a letter, or press a modifier key such as ⌥ twice." : {
      "comment" : "Explanation in the onboarding step that picks the two shortcuts",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意应用里选中文字，然后按快捷键。请选择别处没有用到的，例如 ⌃⌥ 加一个字母，或者连按两次 ⌥ 这样的修饰键。"
          }
        }
      }
    },
    "Shortcuts with only ⌘ clash with app menus. Add ⌃ or ⌥." : {
      "comment" : "A shortcut used only Command (and maybe Shift)",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只带 ⌘ 的快捷键会与应用菜单冲突，请加上 ⌃ 或 ⌥。"
          }
        }
      }
    },
    "Siri and Dictation can also be set to a double press of ⌘ or ⌃. If one is, both respond." : {
      "comment" : "Shown under a shortcut that is ⌘ or ⌃ pressed twice; the shortcut is still saved",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri 和听写也可以设成连按两次 ⌘ 或 ⌃。如果设了，两边都会响应。"
          }
        }
      }
    },
    "Space" : {
      "comment" : "Name of the space bar key",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空格"
          }
        }
      }
    },
    "The Read shortcut already uses this." : {
      "comment" : "The other shortcut already has this combination",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「读」快捷键已经在用这个组合。"
          }
        }
      }
    },
    "The Write shortcut already uses this." : {
      "comment" : "The other shortcut already has this combination",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「写」快捷键已经在用这个组合。"
          }
        }
      }
    },
    "Write" : {
      "comment" : "Name of the shortcut that corrects or translates what the user is writing",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写"
          }
        }
      }
    },
    "macOS already uses this shortcut." : {
      "comment" : "The shortcut is reserved by the system",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 已经在用这个快捷键。"
          }
        }
      }
    },
    "macOS did not accept this shortcut (error %d). Try another one." : {
      "comment" : "Registering the global shortcut failed. The argument is an error number",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 没有接受这个快捷键（错误 %d），请换一个。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
