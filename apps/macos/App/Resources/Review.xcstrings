{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld of %lld" : {
      "comment" : "Accessibility value of the review progress: words rated of the session's words",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld words still due today." : {
      "comment" : "After ending a session early; the argument is how many words are still due",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld word is still due today."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld words are still due today."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "今天还有 %lld 个词到期。"
                }
              }
            }
          }
        }
      }
    },
    "Also met · %@" : {
      "comment" : "Heading over another sentence the word was met in; the argument is app and date",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一次遇到 · %@"
          }
        }
