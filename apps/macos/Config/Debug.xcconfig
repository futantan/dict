//
// Development build: installs side by side with the release build and has its own
// bundle identifier, so privacy grants such as Accessibility stay separate.

#include "Base.xcconfig"

DICT_APP_NAME = $(DICT_PRODUCT_NAME) Dev
DICT_APP_BUNDLE_ID = $(DICT_BUNDLE_ID).dev

// Never the real feed: a Debug build reads only DICT_UPDATE_FEED, a local appcast.
DICT_UPDATE_FEED_URL =
